rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function belongsToCompany(companyId) {
      return isSignedIn() && userCompanyId() == companyId;
    }

    // Login routing — authenticated users read their lookup entry
    match /phone_lookup/{phone} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Auth uid → company mapping
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
    }

    // Company profile
    match /companies/{companyId} {
      allow read, write: if belongsToCompany(companyId)
        || (isSignedIn() && request.auth.uid == companyId);

      match /data/{docId} {
        allow read, write: if belongsToCompany(companyId)
          || (isSignedIn() && request.auth.uid == companyId);
      }
    }

    // Coupons — sirf Cloud Functions (Admin SDK) inhe touch karte hain.
    // Explicit 'false' rakha hai defense-in-depth ke liye; bina isके bhi
    // ye collection default-deny se already surakshit thi (koi rule match
    // nahi karta to Firestore khud deny kar deta hai), lekin explicit
    // rakhna future-proof hai agar kabhi koi wildcard rule add ho jaye.
    match /coupons/{code} {
      allow read, write: if false;
    }

    // Payment dedupe lock — sirf activateSubscriptionForPayment
    // (Cloud Function) ke liye. Client isse kabhi touch nahi karta.
    match /processed_razorpay_payments/{paymentId} {
      allow read, write: if false;
    }

    // Email OTPs — sirf sendEmailOtp / verifyEmailOtp Cloud Functions
    // ke liye. Client seedha padh/likh nahi sakta.
    match /email_otps/{email} {
      allow read, write: if false;
    }

    // Password reset tokens — sirf resetPasswordAfterOtp /
    // verifyEmailOtpForReset Cloud Functions ke liye.
    match /password_reset_tokens/{token} {
      allow read, write: if false;
    }

  }
}
